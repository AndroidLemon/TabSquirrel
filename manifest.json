{
  "manifest_version": 3,
  "name": "Tab Squirrel: Close idle tabs, keep the gist",
  "version": "1.0.0",
  "description": "Closes tabs you leave idle and keeps a short summary of each, so you can let them go. Reopen any tab in one click.",
  "homepage_url": "https://github.com/AndroidLemon/TabSquirrel",
  "minimum_chrome_version": "141",
  "icons": {
    "16": "src/assets/icons/icon-16.png",
    "48": "src/assets/icons/icon-48.png",
    "128": "src/assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Tab Squirrel notebook",
    "default_icon": {
      "16": "src/assets/icons/icon-16.png",
      "48": "src/assets/icons/icon-48.png",
      "128": "src/assets/icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open the notebook"
    },
    "archive_active_tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Save a note of the current tab (it stays open)"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/app/index.html"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "idle",
    "scripting",
    "sidePanel",
    "unlimitedStorage",
    "notifications",
    "favicon",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
